{
	auto_https off
}

# The address of your server (HTTP only on port 80)
:80 {
	@basicSubscription {
		method GET
		path /.well-known/mercure
		header_regexp Authorization (?i)^Basic[[:space:]]
	}
	route {
		# Browsers may resend the demo login on EventSource; Mercure uses the subscriber cookie instead.
		request_header @basicSubscription -Authorization
		mercure {
			cookie_name {$MERCURE_COOKIE_NAME:__Secure-mercure_access_token}
			transport bolt {
				path /data/mercure/mercure.db
			}
			issuer {$MERCURE_JWT_ISSUER:http://localhost} {
				publisher {
					jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
				}
				subscriber {
					jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
				}
			}
		}
	}

	php_server {
		try_files {path} index.php
		root /app/public
	}

	header -X-Powered-By
	header -Server

	route /healthcheck-75ce6228ac8d09dc80af6e956d7ce {
		log_skip
		respond "OK" 200
	}
}
