FROM dunglas/frankenphp:1.13.5-php8.5.12-alpine AS extension-installer

FROM php:8.5.12-cli-alpine

COPY --from=extension-installer /usr/local/bin/install-php-extensions /usr/local/bin/

RUN install-php-extensions \
    apcu \
    zip \
    pdo_pgsql \
    amqp \
    intl \
    mbstring \
    pcntl

RUN apk add --no-cache \
    zip \
    unzip

COPY --from=composer:2.9.8 /usr/bin/composer /usr/bin/composer

ARG USER=appuser

RUN adduser -D -g '' $USER \
    && mkdir -p /app \
    && chown -R $USER:$USER /app

USER $USER

WORKDIR /app

COPY --chown=appuser:appuser docker/worker/php/app.ini /usr/local/etc/php/conf.d/app.ini
COPY --chown=appuser:appuser ./composer.json ./composer.lock* ./

ARG APP_ENV=prod
ENV APP_ENV=${APP_ENV}

RUN if [ "$APP_ENV" = prod ]; then set -- --no-dev; else set --; fi; \
    composer install \
    --no-interaction \
    --no-plugins \
    --no-scripts \
    "$@" \
    --prefer-dist

COPY --chown=appuser:appuser . ./

RUN if [ "$APP_ENV" = prod ]; then \
        composer dump-autoload --optimize --no-dev --classmap-authoritative --apcu \
        && php bin/console cache:clear --env=prod; \
    else \
        composer dump-autoload; \
    fi
